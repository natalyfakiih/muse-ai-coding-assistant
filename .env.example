# Copy this to `.env` and fill in your own keys. `.env` is gitignored; this
# file is committed, so it must never contain a real key.
#
# When you deploy, these go in the host's own environment-variable settings
# (Render: Environment tab), not in a file in the repository.

# --- providers -------------------------------------------------------------
# With neither key set, MUSE runs on its offline stub: the whole three-phase
# flow still works, but every AI reply is canned text rather than a model.
MISTRAL_API_KEY=
GROQ_API_KEY=

# Which provider is tried first. The other one is the failover.
MUSE_PRIMARY=mistral

# --- everything below has a sensible default; leave it alone unless you know
# --- why you are changing it ------------------------------------------------

# SQLite by default. A hosted Postgres URL works too, and is what you want if
# the demo has to survive a restart.
# DATABASE_URL=sqlite:///./muse.db

# Force the offline stub even when keys are present. Useful for a demo where
# you do not want anyone spending your quota.
# USE_FAKE_LLM=1

# Seconds a student's submitted code may run before the sandbox kills it.
# SANDBOX_TIMEOUT_SECONDS=5
