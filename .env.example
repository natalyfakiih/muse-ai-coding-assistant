# TEMPLATE ONLY — committed to git. NEVER put real keys in this file.
# Copy it to .env (which is gitignored) and put your keys THERE:
#     copy .env.example .env
# Editing this file and copying it to .env is the wrong way round: the
# keys end up in the tracked template and get pushed.

# --- database -------------------------------------------------------------
# SQLite runs with zero setup. Switch to Postgres when you want JSONB for real:
# DATABASE_URL=postgresql+psycopg://muse:muse@localhost:5432/muse
DATABASE_URL=sqlite:///./muse.db

# --- providers ------------------------------------------------------------
# Mistral: console.mistral.ai, free "Experiment" tier, no card. ~1B tokens/mo
# but a single-digit requests-per-minute cap — which is why Groq is wired in as
# a fallback for normal concurrent classroom load, not just for outages.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Groq: console.groq.com, no card. ~30 req/min and ~14,400/day at the ORG level
# (extra keys do not raise it). llama-3.1-8b-instant and llama-3.3-70b-versatile
# were deprecated in Aug 2026 — do not build against them.
GROQ_API_KEY=
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# The dialogue tier is the quality-sensitive one (Socratic counter-questions,
# clarifying questions, narrative summaries). Point it somewhere stronger when
# you have budget — nothing in app/modules/ changes.
DIALOGUE_MISTRAL_MODEL=mistral-small-latest
DIALOGUE_GROQ_MODEL=openai/gpt-oss-20b

# Flip the primary for a live demo (e.g. a paid key with no RPM ceiling), then
# flip it back: mistral | groq
MUSE_PRIMARY=mistral

# Run the deterministic offline stub instead of calling anyone. Useful for
# tests and for developing the UI without burning quota.
USE_FAKE_LLM=0

MISTRAL_MAX_RETRIES=2
MISTRAL_BACKOFF_SECONDS=1.5
LLM_TIMEOUT_SECONDS=30

# --- pedagogy knobs (Section 8 calls these starting heuristics, not settled) --
GATE_MAX_ASKS_PER_GAP=2
TUTOR_ESCAPE_HATCH_ROUNDS=3

# --- sandbox --------------------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_MB=256
